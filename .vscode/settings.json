{
  "idf.pythonInstallPath": "/opt/homebrew/bin/python3",
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.formatOnSave": true
  },
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "terminal.integrated.env.osx": {
    "PATH": "/Library/TeX/texbin:${env:PATH}"
  },
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "/usr/bin/perl",
      "args": [
        "/Library/TeX/texbin/latexmk",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "PATH": "/Library/TeX/texbin:/usr/bin:${env:PATH}"
      }
    },
    {
      "name": "lualatexmk",
      "command": "/usr/bin/perl",
      "args": [
        "/Library/TeX/texbin/latexmk",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-lualatex",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "PATH": "/Library/TeX/texbin:/usr/bin:${env:PATH}"
      }
    },
    {
      "name": "xelatexmk",
      "command": "/usr/bin/perl",
      "args": [
        "/Library/TeX/texbin/latexmk",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-xelatex",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "PATH": "/Library/TeX/texbin:/usr/bin:${env:PATH}"
      }
    },
    {
      "name": "latexmk_rconly",
      "command": "/usr/bin/perl",
      "args": ["/Library/TeX/texbin/latexmk", "%DOC%"],
      "env": {
        "PATH": "/Library/TeX/texbin:/usr/bin:${env:PATH}"
      }
    },
    {
      "name": "pdflatex",
      "command": "/Library/TeX/texbin/pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "bibtex",
      "command": "/Library/TeX/texbin/bibtex",
      "args": ["%DOCFILE%"],
      "env": {}
    },
    {
      "name": "rnw2tex",
      "command": "/Library/TeX/texbin/RScript",
      "args": [
        "-e",
        "knitr::opts_knit$set(concordance = TRUE); knitr::knit('%DOCFILE_EXT%')"
      ],
      "env": {}
    },
    {
      "name": "jnw2tex",
      "command": "/Library/TeX/texbin/julia",
      "args": ["-e", "using Weave; weave(\"%DOC_EXT%\", doctype=\"tex\")"],
      "env": {}
    },
    {
      "name": "jnw2texminted",
      "command": "/Library/TeX/texbin/julia",
      "args": [
        "-e",
        "using Weave; weave(\"%DOC_EXT%\", doctype=\"texminted\")"
      ],
      "env": {}
    },
    {
      "name": "pnw2tex",
      "command": "/Library/TeX/texbin/pweave",
      "args": ["-f", "tex", "%DOC_EXT%"],
      "env": {}
    },
    {
      "name": "pnw2texminted",
      "command": "/Library/TeX/texbin/pweave",
      "args": ["-f", "texminted", "%DOC_EXT%"],
      "env": {}
    },
    {
      "name": "tectonic",
      "command": "/Library/TeX/texbin/tectonic",
      "args": ["--synctex", "--keep-logs", "--print", "%DOC%.tex"],
      "env": {}
    }
  ],
  "latex-workshop.latex.outDir": "build"
}
