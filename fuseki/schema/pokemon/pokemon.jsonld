    "@language" : "de",
    "@value" : "Eine Ontologie, die versucht die Pokémon Welt, wie sie in der Anime TV Serie und in den Spielen präsentiert wird, zu beschreiben."
  }, {
    "@language" : "en",
    "@value" : "Ontology covering the Pokémon world as it is presented in games and anime television series."
  } ],
