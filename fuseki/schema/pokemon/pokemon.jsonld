    }, {
      "@id" : "https://pokemonkg.org/ontology#PokédexEntry"
    }, {
      "@id" : "https://pokemonkg.org/ontology#Pokémon"
    }, {
      "@id" : "https://pokemonkg.org/ontology#Region"
    }, {
      "@id" : "https://pokemonkg.org/ontology#Type"
    } ]
  } ]
