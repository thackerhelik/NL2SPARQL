}, {
  "@id" : "https://pokemonkg.org/ontology#PokéType_Dragon",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://pokemonkg.org/ontology#Type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Drachen"
  }, {
    "@language" : "en",
    "@value" : "Dragon"
  } ]
}, {
  "@id" : "https://pokemonkg.org/ontology#PokéType_Electric",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://pokemonkg.org/ontology#Type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Es gibt relativ wenige Electric Pokémon; tatsächlich wurden in der dritten Generation nur vier hinzugefügt. Die meisten basieren auf Nagetieren oder unbelebten Objekten."
  }, {
    "@language" : "en",
    "@value" : "There are relatively few Electric Pokémon; in fact only four were added in the third generation. Most are based on rodents or inanimate objects."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Electric"
  }, {
    "@language" : "de",
    "@value" : "Elektro"
  } ]
}, {
  "@id" : "https://pokemonkg.org/ontology#PokéType_Fairy",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
